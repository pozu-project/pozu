{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "allowImportingTsExtensions": true,
        "jsx": "react-jsx",
        "types": ["node"],
        "typeRoots": ["../node_modules/@types"]
    },
    "include": [
        "../src/**/*.ts",
        "../src/**/*.tsx",
        "../tests/**/*.ts",
        "../tests/**/*.tsx",
        "../configs/**/*.ts"
    ],
    "exclude": ["../node_modules", "../dist"]
}
